/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "trakker",
	"main": "src/index.js",
	"compatibility_date": "2026-10-06",
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,
	"ratelimits": [
		{
			"name": "igdb_rate_limiter",
			"namespace_id": "67",
			"simple": {
				"limit": 10,
				"period": 60,
			},
		},
		{
			"name": "tmdb_rate_limiter",
			"namespace_id": "67",
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	],
	"vars": {
		"igdbPopularityType": 7,
		"igdbPageSize": 40
	},
}
